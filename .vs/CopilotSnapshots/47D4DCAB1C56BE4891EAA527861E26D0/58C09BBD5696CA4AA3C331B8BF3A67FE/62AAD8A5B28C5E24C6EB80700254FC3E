using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using CustomProjectRPG.Interfaces;
using CustomProjectRPG.Core.Utilities;

namespace CustomProjectRPG.Entities.Component
{
    public class StatsComponent : ISerializeJSON
    {
        private int _hp;
        private int _maxHp;
        private int _strength;
        private int _defense;
        private int _agility;

        public StatsComponent(int hp, int maxHp, int strength, int defense, int agility)
        {
            _hp = hp;
            _maxHp = maxHp;
            _strength = strength;
            _defense = defense;
            _agility = agility;
        }

        public int Health
        {
            get => _hp;
            set => _hp = Math.Clamp(value, 0, _maxHp);
        }

        public int MaxHealth => _maxHp;

        public int Strength => _strength;

        public int Defense => _defense;

        public int Agility => _agility;

        public bool IsDead => _hp <= 0;

        public string Serialize()
        {
            var data = new StatsData
            {
                Health = _hp,
                MaxHealth = _maxHp,
                Strength = _strength,
                Defense = _defense,
                Agility = _agility
            };

            return SerializeJSON.ToJson(data);
        }

        public void Deserialize(string json)
        {
            if (string.IsNullOrWhiteSpace(json)) return;

            try
            {
                var data = SerializeJSON.FromJson<StatsData>(json);
                if (data != null)
                {
                    _hp = data.Health;
                    _maxHp = data.MaxHealth;
                    _strength = data.Strength;
                    _defense = data.Defense;
                    _agility = data.Agility;
                }
            }
            catch (InvalidOperationException)
            {
                _hp = 0;
                _maxHp = 0;
                _strength = 0;
                _defense = 0;
                _agility = 0;
            }
        }

        private class StatsData
        {
            public int Health { get; set; }
            public int MaxHealth { get; set; }
            public int Strength { get; set; }
            public int Defense { get; set; }
            public int Agility { get; set; }
        }
    }
}
